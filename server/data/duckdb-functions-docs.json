        "read_csv": {
            "function_name": "read_csv",
            "category": "I/O",
            "snippet": "read_csv('${1:file.csv}', header = ${2:true}, delim = '${3:,}')",
            "doc": "**read_csv**(path, ...options)\n\nRead a CSV file into a table.\n\n**Key Parameters:**\n| Parameter | Type | Default | Description |\n|-----------|------|---------|-------------|\n| `header` | BOOL | `true` | First row contains column names |\n| `delim` | VARCHAR | `,` | Column delimiter |\n| `quote` | VARCHAR | `\"` | Quote character |\n| `escape` | VARCHAR | `\"` | Escape character |\n| `columns` | STRUCT | auto | Explicit column name→type mapping |\n| `auto_detect` | BOOL | `true` | Auto-detect types and delimiter |\n| `skip` | INTEGER | `0` | Number of header rows to skip |\n| `nullstr` | VARCHAR | `(empty)` | String that represents NULL |\n| `sample_size` | INTEGER | `20480` | Rows sampled for auto-detection |\n| `all_varchar` | BOOL | `false` | Read all columns as VARCHAR |\n| `dateformat` | VARCHAR | auto | Date parsing format |\n| `timestampformat` | VARCHAR | auto | Timestamp parsing format |\n| `compression` | VARCHAR | auto | `none`, `gzip`, `zstd` |\n| `filename` | BOOL | `false` | Add source filename column |\n| `union_by_name` | BOOL | `false` | Merge schemas from multiple files |",
            "examples": [
                "SELECT * FROM read_csv('data.csv')",
                "SELECT * FROM read_csv('data.tsv', delim = '\\t', header = true)",
                "SELECT * FROM read_csv('data/*.csv', union_by_name = true, filename = true)"
            ]
        },
        "read_csv_auto": {
            "function_name": "read_csv_auto",
            "category": "I/O",
            "snippet": "read_csv_auto('${1:file.csv}')",
            "doc": "**read_csv_auto**(path)\n\nRead CSV with automatic type detection. Alias for `read_csv` with `auto_detect = true`.",
            "examples": [
                "SELECT * FROM read_csv_auto('sales_2024.csv')",
                "SELECT * FROM read_csv_auto('data/*.csv')"
            ]
        },
        "read_parquet": {
            "function_name": "read_parquet",
            "category": "I/O",
            "snippet": "read_parquet('${1:file.parquet}')",
            "doc": "**read_parquet**(path, ...options)\n\nRead Apache Parquet files.\n\n**Key Parameters:**\n| Parameter | Type | Default | Description |\n|-----------|------|---------|-------------|\n| `hive_partitioning` | BOOL | `false` | Enable Hive-style partition parsing |\n| `union_by_name` | BOOL | `false` | Merge schemas across files |\n| `filename` | BOOL | `false` | Add source filename column |\n| `file_row_number` | BOOL | `false` | Add row number within file |",
            "examples": [
                "SELECT * FROM read_parquet('data.parquet')",
                "SELECT * FROM read_parquet('s3://bucket/data/*/*.parquet', hive_partitioning = true)",
                "SELECT * FROM read_parquet(['file1.parquet', 'file2.parquet'])"
            ]
        },
        "read_json": {
            "function_name": "read_json",
            "category": "I/O",
            "snippet": "read_json('${1:file.json}')",
            "doc": "**read_json**(path, ...options)\n\nRead JSON files (NDJSON, JSON arrays, or objects).\n\n**Key Parameters:**\n| Parameter | Type | Default | Description |\n|-----------|------|---------|-------------|\n| `auto_detect` | BOOL | `true` | Auto-detect schema |\n| `format` | VARCHAR | `auto` | `auto`, `array`, `newline_delimited`, `values` |\n| `columns` | STRUCT | auto | Explicit column→type map |\n| `records` | VARCHAR | `auto` | `auto`, `true`, `false` |\n| `maximum_depth` | INTEGER | `-1` | Max nesting depth |\n| `sample_size` | INTEGER | `20480` | Rows sampled for auto-detection |",
            "examples": [
                "SELECT * FROM read_json('data.json')",
                "SELECT * FROM read_json('logs/*.jsonl', format = 'newline_delimited')"
