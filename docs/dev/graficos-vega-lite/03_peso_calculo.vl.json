{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "name": "dataset"
  },
  "width": 420,
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "canal",
      "type": "nominal",
      "sort": {
        "op": "max",
        "field": "peso",
        "order": "descending"
      },
      "title": null
    },
    "yOffset": {
      "field": "calculo",
      "sort": [
        "Promedio simple",
        "CPA del cliente"
      ]
    },
    "x": {
      "field": "peso",
      "type": "quantitative",
      "axis": {
        "format": ".0%"
      },
      "title": "Peso en el cálculo"
    },
    "color": {
      "field": "calculo",
      "scale": {
        "domain": [
          "Promedio simple",
          "CPA del cliente"
        ],
        "range": [
          "#b8bcc4",
          "#f2545b"
        ]
      },
      "legend": {
        "orient": "top",
        "title": null
      }
    }
  }
}