{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Venta mensual",
    "subtitle": "Enero 2023 a octubre 2024 (octubre incompleto)"
  },
  "data": {
    "name": "dataset"
  },
  "mark": "area",
  "encoding": {
    "x": {
      "field": "mes",
      "type": "nominal"
    },
    "y": {
      "aggregate": "sum",
      "field": "venta",
      "type": "quantitative"
    }
  },
  "usermeta": {
    "amoxsql": {
      "version": 2,
      "modo": "interfaz",
      "consulta": "SELECT date_trunc('month', fecha)::DATE AS mes, round(sum(importe), 2) AS venta FROM ventas GROUP BY ALL ORDER BY mes",
      "interfaz": {
        "chartType": "area",
        "xAxisKey": "mes",
        "yAxisKeys": [
          "venta"
        ],
        "numberFormat": "compact",
        "colorTheme": "ocean",
        "chartTitle": "Venta mensual",
        "chartSubtitle": "Enero 2023 a octubre 2024 (octubre incompleto)",
        "chartFootnote": "Fuente: archivos mensuales de ventas · tienda.duckdb"
      }
    }
  }
}
