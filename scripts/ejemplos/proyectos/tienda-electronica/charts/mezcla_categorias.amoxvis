{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Mezcla por categoría, 2024",
    "subtitle": "Portátiles y teléfonos son más de la mitad de la venta"
  },
  "data": {
    "name": "dataset"
  },
  "mark": {
    "type": "arc",
    "innerRadius": 60
  },
  "encoding": {
    "theta": {
      "aggregate": "sum",
      "field": "venta",
      "type": "quantitative"
    },
    "color": {
      "field": "categoria",
      "type": "nominal"
    }
  },
  "usermeta": {
    "amoxsql": {
      "version": 2,
      "modo": "interfaz",
      "consulta": "SELECT categoria, round(sum(importe), 2) AS venta FROM ventas WHERE fecha >= DATE '2024-01-01' GROUP BY ALL ORDER BY venta DESC",
      "interfaz": {
        "chartType": "donut",
        "xAxisKey": "categoria",
        "yAxisKeys": [
          "venta"
        ],
        "numberFormat": "compact",
        "colorTheme": "ocean",
        "chartTitle": "Mezcla por categoría, 2024",
        "chartSubtitle": "Portátiles y teléfonos son más de la mitad de la venta"
      }
    }
  }
}
